# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://haditech.com
NEXT_PUBLIC_EMAIL=haditech313@gmail.com
CONTACT_EMAIL=haditech313@gmail.com

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=your_admin_password_here

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here
# Must be a verified sender in your Resend account.
# Without this, Resend will only deliver to addresses verified in your account.
RESEND_FROM_EMAIL=HADITECH Contact <notifications@yourdomain.com>

# ─── Meta WhatsApp Cloud API ──────────────────────────────────────────────────
# Preferred (new) env names:
META_WHATSAPP_TOKEN=your_meta_whatsapp_access_token_here
META_WHATSAPP_PHONE_ID=your_phone_number_id_here
WHATSAPP_NOTIFY_TO=923012475707
META_WHATSAPP_API_VERSION=v22.0

# Backward-compatible aliases (the code checks new names first, then falls back to these):
# META_WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
# META_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# WHATSAPP_DEFAULT_TO=923012475707

# ─── Optional ─────────────────────────────────────────────────────────────────
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id_here
